# ============================================================
#  Configuração do Portal Inclusão Digital (copie para ".env")
# ============================================================
# Nenhuma destas chaves é obrigatória para o site funcionar.
# Sem chaves, o Verificador de Notícias mostra uma resposta
# segura padrão ("não foi verificado, por segurança não repasse").
#
# >>> NUNCA envie o arquivo .env para o GitHub ou para o chat. <<<

# ---- Google Fact Check Tools API (opcional) ----
# Gere em: https://console.cloud.google.com/  (ative "Fact Check Tools API")
GOOGLE_FACTCHECK_API_KEY=

# ---- IA para redigir a resposta acolhedora (opcional) ----
# Provedor: "anthropic" (padrão) ou "openai"
LLM_PROVIDER=anthropic
# Chave da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Ou, se usar OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Geral ----
# Porta interna do app (o painel/Nginx faz o proxy para a 80/443)
PORT=8000
